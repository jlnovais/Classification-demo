NODE_ENV=development
PORT=3000

# Connection to an existing PostgreSQL instance
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=classification_demo

# Claude API (https://platform.claude.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# FX API (https://www.frankfurter.app/)
# example: 
# https://api.frankfurter.dev/v1/2026-09-23?base=USD&symbols=EUR&amount=2.95

FX_API_URL_TEMPLATE=https://api.frankfurter.dev/v1/{date}?base={base}&symbols={symbols}&amount={amount}
FX_API_TIMEOUT_MS=5000
